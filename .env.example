# Copy this file to .env and fill it in. NEVER commit the real .env.
# The .gitignore already blocks .env so your secret stays local.

# The management API URL printed at the end of bootstrap.sh.
# Looks like: https://YOUR_SERVER_IP:25565/S3cr3tPath
# This is a SECRET. Treat it like a root password.
ICEVPN_API_URL="https://YOUR_SERVER_IP:25565/REPLACE_WITH_SECRET_PATH"

# Ports (must match what you set in bootstrap.sh)
SSH_PORT=22
MGMT_PORT=25565
KEYS_PORT=44444

# Tier settings
FREE_TIER_GB=5